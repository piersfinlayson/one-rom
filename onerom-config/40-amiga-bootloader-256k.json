{
    "$schema": "https://images.onerom.org/configs/schema.json",
    "version": 1,
    "name": "Amiga Bootloader (256KB)",
    "description": "Reference bootloader and the RBCP test applications",
    "categories": [
        "computer",
        "commodore",
        "amiga",
        "rbcp"
    ],
    "chip_sets": [
        {
            "type": "single",
            "chips": [
                {
                    "type": "system_plugin",
                    "plugin": "usb"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "type": "user_plugin",
                    "plugin": "host-control"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Bootloader",
                    "file": "https://images.onerom.org/roms/host-control/amiga-boot/latest/amiga_boot_256k.bin",
                    "type": "27C200"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Terminal",
                    "file": "https://images.onerom.org/roms/host-control/amiga-rbcp-term/latest/amiga_term_256k.bin",
                    "type": "27C200"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "LED Tester",
                    "file": "https://images.onerom.org/roms/host-control/amiga-led-test/latest/amiga_led_test_256k.bin",
                    "type": "27C200"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Aux I/O Tester",
                    "file": "https://images.onerom.org/roms/host-control/amiga-aux-io/latest/amiga_auxio_256k.bin",
                    "type": "27C200"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Pipe Throughput Test",
                    "file": "https://images.onerom.org/roms/host-control/amiga-pipe-test/latest/amiga_pipe_256k.bin",
                    "type": "27C200"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Reliability Meter",
                    "file": "https://images.onerom.org/roms/host-control/amiga-rbcp-stress/latest/amiga_meter_256k.bin",
                    "type": "27C200"
                }
            ]
        }
    ]
}