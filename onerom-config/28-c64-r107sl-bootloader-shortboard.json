{
    "$schema": "https://images.onerom.org/configs/schema.json",
    "version": 1,
    "name": "C64 r107sl Bootloader (shortboard)",
    "description": "r107sl's bootloader, stock BASIC and kernal and the RBCP test applications",
    "categories": [
        "computer",
        "commodore",
        "c64",
        "rbcp"
    ],
    "chip_sets": [
        {
            "type": "single",
            "chips": [
                {
                    "type": "system_plugin",
                    "plugin": "usb"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "type": "user_plugin",
                    "plugin": "host-control"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Bootloader",
                    "file": "https://images.onerom.org/roms/host-control/c64-bootloader/latest/c64_bootloader_c64c.bin",
                    "type": "23128",
                    "cs1": "active_low",
                    "cs2": "active_low",
                    "cs3": "active_high"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "BASIC+Kernal 251913-01",
                    "file": "http://www.zimmers.net/anonftp/pub/cbm/firmware/computers/c64/64c.251913-01.bin",
                    "type": "23128",
                    "cs1": "active_low",
                    "cs2": "active_low",
                    "cs3": "active_high"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Terminal",
                    "file": "https://images.onerom.org/roms/host-control/c64-rbcp-term/latest/c64_term_combined.bin",
                    "type": "23128",
                    "cs1": "active_low",
                    "cs2": "active_low",
                    "cs3": "active_high"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "LED Tester",
                    "file": "https://images.onerom.org/roms/host-control/c64-led-test/latest/c64_led_combined.bin",
                    "type": "23128",
                    "cs1": "active_low",
                    "cs2": "active_low",
                    "cs3": "active_high"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Aux I/O Tester",
                    "file": "https://images.onerom.org/roms/host-control/c64-aux-io/latest/c64_auxio_combined.bin",
                    "type": "23128",
                    "cs1": "active_low",
                    "cs2": "active_low",
                    "cs3": "active_high"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Pipe Throughput Test",
                    "file": "https://images.onerom.org/roms/host-control/c64-pipe-test/latest/c64_pipe_combined.bin",
                    "type": "23128",
                    "cs1": "active_low",
                    "cs2": "active_low",
                    "cs3": "active_high"
                }
            ]
        },
        {
            "type": "single",
            "chips": [
                {
                    "label": "Reliability Meter",
                    "file": "https://images.onerom.org/roms/host-control/c64-rbcp-stress/latest/c64_meter_combined.bin",
                    "type": "23128",
                    "cs1": "active_low",
                    "cs2": "active_low",
                    "cs3": "active_high"
                }
            ]
        }
    ]
}